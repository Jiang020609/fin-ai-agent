# --- LLM 配置 ---
# OpenAI 直连:
#   OPENAI_API_KEY=sk-xxx
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_MODEL=gpt-4o-mini
#
# OpenRouter + DeepSeek:
#   OPENAI_API_KEY=sk-or-v1-xxx  (你的 OpenRouter key)
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=deepseek/deepseek-chat-v3-0324
#   EMBEDDING_MODEL=openai/text-embedding-3-small

OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=deepseek/deepseek-chat-v3-0324
EMBEDDING_MODEL=openai/text-embedding-3-small

# --- 行情数据源（可选，不填则仅用 yfinance）---
# Finnhub: https://finnhub.io/register 免费注册，60次/分钟
FINNHUB_API_KEY=
# Alpha Vantage: https://www.alphavantage.co/support/#api-key 免费注册，25次/天
ALPHA_VANTAGE_API_KEY=

# --- Web Search 兜底（可选，RAG 未命中时使用）---
# Tavily: https://tavily.com 或 SerpAPI: https://serpapi.com
SEARCH_API_KEY=
SEARCH_PROVIDER=tavily  # tavily | serpapi

# --- RAG 高级配置 ---
HYBRID_WEIGHT=0.5       # BM25权重 (0=纯向量, 1=纯BM25)
RERANK_ENABLED=true     # 是否启用 LLM 重排序
RERANK_TOP_K=3          # 重排序后保留条数
